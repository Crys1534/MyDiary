<?xml version="1.0" encoding="utf-8"?>
<!-- A link inside a diary: a card with the picture, the title and the description of the web page -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/diary_audio_bg"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:padding="8dp">

    <!-- Hidden when the page has no picture -->
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/SDV_diary_link_image"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginRight="10dp"
        android:visibility="gone"
        fresco:actualImageScaleType="centerCrop"
        fresco:roundedCornerRadius="8dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/TV_diary_link_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/app_text"
            android:textSize="15dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/TV_diary_link_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/app_text_secondary"
            android:textSize="12dp" />

        <TextView
            android:id="@+id/TV_diary_link_domain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="11dp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/IV_diary_link_delete"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginLeft="6dp"
        android:background="@color/diary_photo_layout_delete_bg"
        android:padding="6dp"
        android:src="@drawable/ic_delete_white_24dp"
        android:visibility="gone" />

</LinearLayout>
