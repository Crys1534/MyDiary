<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activity_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- The header: the banner, the profile picture, the name and how many diaries and entries there are -->
    <FrameLayout
        android:id="@+id/FL_main_header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/main_header_height"
        android:layout_alignParentTop="true">

        <ImageView
            android:id="@+id/IV_main_banner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/main_header_shade" />

        <LinearLayout
            android:id="@+id/LL_main_profile"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fitsSystemWindows="true"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:paddingBottom="14dp"
            android:paddingLeft="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/IV_main_profile_picture"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:src="@drawable/ic_person_picture_default"
                app:civ_border_color="@android:color/white"
                app:civ_border_width="2dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/TV_main_profile_username"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:shadowColor="@color/textview_shadow"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    android:textColor="@android:color/white"
                    android:textSize="21dp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/TV_main_profile_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:shadowColor="@color/textview_shadow"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="2"
                    android:textColor="#E9ECF2"
                    android:textSize="13dp" />
            </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>


    <!-- "A day like today": the diaries written on this day in other years -->
    <LinearLayout
        android:id="@+id/LL_main_today_wrap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/FL_main_header"
        android:background="@color/main_desk"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/LL_main_today"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingBottom="10dp"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="10dp">

            <TextView
                android:id="@+id/TV_main_today_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/today_card_title"
                android:textColor="@android:color/white"
                android:textSize="16dp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/TV_main_today_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@android:color/white"
                android:textSize="13dp" />
        </LinearLayout>
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/RL_main_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_bar_height"
        android:layout_alignParentBottom="true"
        android:background="@color/app_surface"
        android:focusable="true"
        android:focusableInTouchMode="true">


        <ImageView
            android:id="@+id/IV_main_setting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="10dp"
            android:src="@drawable/ic_settings_black_24dp"
            android:tint="@color/app_icon" />

        <EditText
            android:id="@+id/EDT_main_topic_search"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:layout_centerVertical="true"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_toLeftOf="@id/IV_main_setting"
            android:background="@drawable/edittext_rounded_corner_bg"
            android:drawableLeft="@drawable/ic_search_white_18dp"
            android:inputType="textCapSentences"
            android:maxLines="1"
            android:textColor="@android:color/white"
            android:textSize="16dp" />

    </RelativeLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/RecyclerView_topic"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/RL_main_bottom_bar"
        android:layout_below="@id/LL_main_today_wrap"
        android:background="@color/main_desk"
        android:clipToPadding="false"
        android:paddingBottom="10dp"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="6dp" />

    <!-- Appears over the topics while something is written in the search box -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/RecyclerView_search_results"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/RL_main_bottom_bar"
        android:layout_below="@id/FL_main_header"
        android:background="@color/app_surface"
        android:clipToPadding="false"
        android:paddingBottom="10dp"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="4dp"
        android:visibility="gone" />

    <View
        android:id="@+id/profile_shadow"
        android:layout_width="match_parent"
        android:layout_height="@dimen/shadow_height_5dp"
        android:layout_below="@id/FL_main_header"
        android:background="@drawable/view_bottom_shadow" />

    <View
        android:id="@+id/search_shadow"
        android:layout_width="match_parent"
        android:layout_height="@dimen/shadow_height_3dp"
        android:layout_above="@id/RL_main_bottom_bar"
        android:background="@drawable/view_top_shadow" />

</RelativeLayout>
