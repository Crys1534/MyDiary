<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <LinearLayout
        android:id="@+id/LL_diary_edit_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_bar_height"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:orientation="horizontal">


        <ImageView
            android:id="@+id/IV_diary_menu"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scaleType="center"
            android:clickable="false"
            android:src="@drawable/ic_more_horiz_white_24dp"
            android:tint="@color/button_disable_color" />

        <ImageView
            android:id="@+id/IV_diary_photo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scaleType="center"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_photo_camera_white_24dp" />

        <ImageView
            android:id="@+id/IV_diary_bold"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scaleType="center"
            android:src="@drawable/ic_format_bold_white_24dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/IV_diary_italic"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scaleType="center"
            android:src="@drawable/ic_format_italic_white_24dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/IV_diary_list"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scaleType="center"
            android:src="@drawable/ic_format_list_bulleted_white_24dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/IV_diary_checklist"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scaleType="center"
            android:src="@drawable/ic_checklist_white_24dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/IV_diary_audio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scaleType="center"
            android:src="@drawable/ic_audiotrack_white_24dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/IV_diary_move"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scaleType="center"
            android:src="@drawable/ic_drive_file_move_white_24dp"
            android:visibility="gone" />

        <!-- Only when reading an entry (not while writing it) -->
        <ImageView
            android:id="@+id/IV_diary_delete"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scaleType="center"
            android:src="@drawable/ic_delete_white_24dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/IV_diary_save"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scaleType="center"
            android:src="@drawable/ic_save_white_24dp" />


    </LinearLayout>

    <ScrollView
        android:id="@+id/ScrollView_diary_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/LL_diary_edit_bar"
        android:fillViewport="true"
        android:scrollbarSize="5dp"
        android:scrollbarStyle="insideOverlay">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="true"
            android:focusableInTouchMode="true">

            <!-- The cover: the photo chosen as the thumbnail is the background -->
            <!-- Always the same shape (4:5, taller than wide): a photo cropped to that shape fills it exactly -->
            <com.kiminonawa.mydiary.shared.gui.AspectRatioRelativeLayout
                android:id="@+id/RL_diary_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.facebook.drawee.view.SimpleDraweeView
                    android:id="@+id/SDV_diary_cover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"
                    fresco:actualImageScaleType="centerCrop" />

                <View
                    android:id="@+id/V_diary_cover_overlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/diary_cover_overlay"
                    android:visibility="gone" />

                <!-- In the middle: the date (only month and day) and under it the title -->
                <LinearLayout
                    android:id="@+id/LL_diary_time_information"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingLeft="24dp"
                    android:paddingRight="24dp">

                    <TextView
                        android:id="@+id/TV_diary_month"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/TV_diary_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:shadowColor="#AA000000"
                        android:shadowDx="1"
                        android:shadowDy="1"
                        android:shadowRadius="3"
                        android:textColor="@android:color/white"
                        android:textSize="21dp" />

                    <LinearLayout
                        android:id="@+id/LL_diary_day_and_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/TV_diary_day"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:id="@+id/TV_diary_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/TV_diary_cover_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="2"
                        android:shadowColor="#AA000000"
                        android:shadowDx="1"
                        android:shadowDy="1"
                        android:shadowRadius="3"
                        android:textColor="@android:color/white"
                        android:textSize="31dp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Top: the weather in the left corner, the place in the right corner -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:paddingTop="6dp">

                    <ImageView
                        android:id="@+id/IV_diary_weather"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:tint="@android:color/white"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/TV_diary_weather"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:shadowColor="#AA000000"
                        android:shadowDx="1"
                        android:shadowDy="1"
                        android:shadowRadius="2"
                        android:textColor="@android:color/white"
                        android:textSize="13dp"
                        android:visibility="gone" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/IV_diary_location_name_icon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_location_on_white_24dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/TV_diary_location"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxEms="14"
                        android:maxLines="1"
                        android:paddingBottom="6dp"
                        android:paddingTop="6dp"
                        android:shadowColor="#AA000000"
                        android:shadowDx="1"
                        android:shadowDy="1"
                        android:shadowRadius="2"
                        android:textColor="@android:color/white"
                        android:textSize="13dp" />

                    <ImageView
                        android:id="@+id/IV_diary_close_dialog"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:src="@drawable/ic_clear_white_36dp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Bottom right: one tag, a "+" button when there are more, a pencil when there are none -->
                <LinearLayout
                    android:id="@+id/LL_diary_cover_tags"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_alignParentRight="true"
                    android:layout_marginBottom="10dp"
                    android:layout_marginRight="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/TV_diary_cover_tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/diary_cover_chip_bg"
                        android:ellipsize="end"
                        android:maxEms="10"
                        android:maxLines="1"
                        android:paddingBottom="4dp"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:paddingTop="4dp"
                        android:textColor="@android:color/white"
                        android:textSize="14dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/TV_diary_cover_tag_more"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:background="@drawable/diary_cover_chip_bg"
                        android:gravity="center"
                        android:minWidth="30dp"
                        android:paddingBottom="4dp"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:paddingTop="4dp"
                        android:text="+"
                        android:textColor="@android:color/white"
                        android:textSize="14dp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/IV_diary_cover_tag_add"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@drawable/diary_cover_chip_bg"
                        android:padding="6dp"
                        android:src="@drawable/ic_pencil_white_24dp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Bottom left (only when editing and the cover has a photo): choose the part of the photo that the cover shows -->
                <ImageView
                    android:id="@+id/IV_diary_cover_crop"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_alignParentBottom="true"
                    android:layout_alignParentLeft="true"
                    android:layout_marginBottom="10dp"
                    android:layout_marginLeft="10dp"
                    android:background="@drawable/diary_cover_chip_bg"
                    android:padding="6dp"
                    android:src="@drawable/ic_area_white_24dp"
                    android:visibility="gone" />

            </com.kiminonawa.mydiary.shared.gui.AspectRatioRelativeLayout>


            <LinearLayout
                android:id="@+id/RL_diary_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/RL_diary_info"
                android:background="@color/app_surface"
                android:orientation="vertical"
                android:padding="5dp">


                <LinearLayout
                    android:id="@+id/RL_diary_title_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:weightSum="1">

                    <EditText
                        android:id="@+id/EDT_diary_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.7"
                        android:hint="@string/diary_title_hint"
                        android:inputType="textCapSentences"
                        android:maxLines="1"
                        android:textColor="@color/app_text"
                        android:textColorHint="@color/edittext_hint" />

                    <RelativeLayout
                        android:id="@+id/RL_diary_weather"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="2dp"
                        android:layout_weight="0.15">

                        <Spinner
                            android:id="@+id/SP_diary_weather"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:gravity="center" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/RL_diary_mood"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="2dp"
                        android:layout_weight="0.15">

                        <Spinner
                            android:id="@+id/SP_diary_mood"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:gravity="center" />
                    </RelativeLayout>

                    <TextView
                        android:id="@+id/TV_diary_title_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:textSize="28dp"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- Tags like #school #trip: this box only keeps the text (it is never seen), the pencil of the cover opens a window to write them -->
                <EditText
                    android:id="@+id/EDT_diary_tags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/diary_tags_hint"
                    android:inputType="text|textNoSuggestions"
                    android:maxLines="1"
                    android:textColor="@color/app_text"
                    android:textColorHint="@color/edittext_hint"
                    android:textSize="16dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/TV_diary_tags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textSize="16dp"
                    android:visibility="gone" />


                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/TV_diary_item_content_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:text="@string/diary_content_hint"
                        android:textSize="28dp"
                        android:visibility="gone" />

                    <ProgressBar
                        android:id="@+id/PB_diary_item_content_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/LL_diary_item_content"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">


                    </LinearLayout>
                </RelativeLayout>
            </LinearLayout>
        </RelativeLayout>

    </ScrollView>


    <View
        android:id="@+id/diary_edit_bar_shadow"
        android:layout_width="match_parent"
        android:layout_height="@dimen/shadow_height_3dp"
        android:layout_above="@id/LL_diary_edit_bar"
        android:background="@drawable/view_top_shadow" />
</RelativeLayout>

