<?xml version="1.0" encoding="utf-8"?>
<!-- A category of the main screen: a notebook of its color with a photo taped on the cover and a label -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/RL_topic_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingBottom="8dp"
    android:paddingLeft="8dp"
    android:paddingRight="8dp"
    android:paddingTop="8dp">

    <FrameLayout
        android:id="@+id/FL_topic_notebook"
        android:layout_width="match_parent"
        android:layout_height="142dp"
        android:clipChildren="false"
        android:elevation="5dp">

        <!-- The elastic band of the notebook -->
        <View
            android:id="@+id/V_topic_band"
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:layout_gravity="right"
            android:layout_marginRight="14dp"
            android:background="#4D000000" />

        <!-- The photo (polaroid) -->
        <FrameLayout
            android:id="@+id/FL_topic_photo"
            android:layout_width="86dp"
            android:layout_height="80dp"
            android:layout_marginLeft="22dp"
            android:layout_marginTop="10dp"
            android:background="#FFFDF8"
            android:elevation="3dp"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:paddingTop="4dp">

            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/IV_topic_cover"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                app:actualImageScaleType="centerCrop" />

            <ImageView
                android:id="@+id/IV_topic_icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp" />
        </FrameLayout>

        <!-- The tape that holds the photo -->
        <View
            android:id="@+id/V_topic_tape"
            android:layout_width="34dp"
            android:layout_height="12dp"
            android:layout_marginLeft="46dp"
            android:layout_marginTop="4dp"
            android:background="#BFFFF5C8"
            android:elevation="4dp"
            android:rotation="-4" />

        <!-- It has categories inside -->
        <TextView
            android:id="@+id/TV_topic_folder_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:layout_marginRight="22dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/topic_folder_badge"
            android:elevation="3dp"
            android:paddingBottom="1dp"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="1dp"
            android:textColor="#2B1D12"
            android:textSize="12dp"
            android:textStyle="bold"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/IV_topic_menu"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="right"
            android:layout_marginRight="22dp"
            android:contentDescription="@string/topic_menu"
            android:padding="6dp"
            android:src="@drawable/ic_more_horiz_white_24dp" />

        <!-- The label: name and how many there are -->
        <LinearLayout
            android:id="@+id/LL_topic_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="9dp"
            android:layout_marginLeft="18dp"
            android:layout_marginRight="26dp"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="2dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="2dp">

            <TextView
                android:id="@+id/TV_topic_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#2B1D12"
                android:textSize="17dp" />

            <TextView
                android:id="@+id/TV_topic_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:maxLines="1"
                android:textColor="#6B5240"
                android:textSize="12dp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
