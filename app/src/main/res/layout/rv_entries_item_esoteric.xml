<?xml version="1.0" encoding="utf-8"?>
<!-- One entry in the list of a category with the Esoteric theme (the same ids as rv_entries_item, see EntryCardHolder):
     the day big on the left, then the hour, title and icons, and the photo framed on the right. Colors and letters: EsotericStyle -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="12dp"
    android:paddingRight="12dp">

    <TextView
        android:id="@+id/TV_entries_item_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="12dp"
        android:layout_marginTop="16dp" />

    <RelativeLayout
        android:id="@+id/RL_entries_item_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:minHeight="92dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="92dp"
            android:orientation="horizontal"
            android:paddingBottom="12dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="12dp">

            <LinearLayout
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/TV_entries_item_eso_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textSize="40sp" />

                <TextView
                    android:id="@+id/TV_entries_item_eso_weekday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="56dp"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="14dp"
                android:background="#FF2A1A1E" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/TV_entries_item_time"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1" />

                    <LinearLayout
                        android:id="@+id/LL_entries_item_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/IV_entries_item_weather"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:padding="1dp"
                            android:src="@drawable/ic_weather_sunny" />

                        <ImageView
                            android:id="@+id/IV_entries_item_mood"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:visibility="gone"
                            android:src="@drawable/ic_mood_happy" />

                        <ImageView
                            android:id="@+id/IV_entries_item_bookmark"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginLeft="6dp"
                            android:padding="1dp"
                            android:src="@drawable/ic_bookmark_border" />

                        <ImageView
                            android:id="@+id/IV_entries_item_attachment"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginLeft="6dp"
                            android:padding="1dp"
                            android:src="@drawable/ic_attach" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/TV_entries_item_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="2" />

                <TextView
                    android:id="@+id/TV_entries_item_snippet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textSize="15sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- The photo of the entry, in a dark red frame (hidden when there is no photo) -->
            <FrameLayout
                android:id="@+id/LL_entries_item_day"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:layout_marginLeft="12dp"
                android:background="#FF5A1A24"
                android:padding="1dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/IV_entries_item_thumbnail_placeholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <com.facebook.drawee.view.SimpleDraweeView
                    android:id="@+id/SDV_entries_item_thumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"
                    fresco:actualImageScaleType="centerCrop" />
            </FrameLayout>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
